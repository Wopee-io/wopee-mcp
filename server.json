{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Wopee-io/wopee-mcp",
  "description": "Wopee.io AI testing agents: dispatch analyses and test runs, fetch artifacts and results.",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/Wopee-io/wopee-mcp/main/assets/brand/wopee-symbol-color-light.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/Wopee-io/wopee-mcp/main/assets/brand/wopee-symbol-color-light.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/Wopee-io/wopee-mcp",
    "source": "github"
  },
  "version": "1.33.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "wopee-mcp",
      "version": "1.33.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Wopee.io API key for authentication",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "WOPEE_API_KEY"
        },
        {
          "description": "UUID of the Wopee.io project to work with",
          "isRequired": true,
          "format": "string",
          "isSecret": false,
          "name": "WOPEE_PROJECT_UUID"
        },
        {
          "description": "Wopee.io API base URL, only for dedicated or self-hosted instances (defaults to https://api.wopee.io)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "WOPEE_API_URL"
        }
      ]
    }
  ]
}
